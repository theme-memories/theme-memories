---
import { WEATHER_PLACEHOLDER } from "../utils/weather";

interface Props {
  /** Place the crawler is configured for; see the `cron` worker's wrangler config. */
  location?: string;
}

const { location = "根室市" } = Astro.props;
---

<!--
  A reading, not a dashboard. It sits in the margin of the index as a bordered
  plate, so it is only ever as wide as its column and never competes with the
  writing. The essentials come first; the full set of readings follows the hairline
  for the reader who wants them. The snapshot is crawled every ten minutes and
  served from object storage, so it is filled in by `enhanceWeatherWidget`
  rather than at build time.

  The plate is `self-start` rather than stretched to the index column's height,
  which is what a grid item does by default. It holds a reading, and when the
  crawl has not come back the only honest height is the height of the sentence
  that says so; stretched, a failed request left a 427px bordered box holding
  16px of text.
-->
<section
  class="plate self-start"
  data-weather
  tabindex="-1"
  aria-labelledby="weather-heading"
>
  <div class="plate-head">
    <h2 id="weather-heading" class="label">
      天気
    </h2>
    <span class="data">{location}</span>
  </div>

  <div class="plate-body">
    <div aria-live="polite" data-weather-live>
      <!--
        The skeleton belongs to the script, not to the page. It used to be drawn
        from the first paint and hidden by the script once the crawl answered,
        which meant a browser without scripting shimmered here for as long as the
        tab stayed open: a placeholder for work nothing was going to do.

        Revealed by `load()` now, the same way the loader is revealed by the head
        script, so it is only ever shown to a browser that can also take it away.
      -->
      <div class="flex items-center gap-4" data-weather-loading hidden>
        <div class="skeleton size-10 shrink-0"></div>
        <div class="w-full space-y-2">
          <div class="skeleton h-7 w-24"></div>
          <div class="skeleton h-3 w-32"></div>
        </div>
      </div>

      <p class="data" data-weather-error hidden></p>

      <div data-weather-content hidden>
        <div class="flex items-start gap-4">
          <div
            class="flex size-10 shrink-0 items-center justify-center"
            data-weather-icon
          ></div>
          <div class="min-w-0">
            <p class="text-3xl leading-none font-bold tracking-tight">
              <span data-weather-temp>{WEATHER_PLACEHOLDER}</span>
            </p>
            <p
              class="text-[color:var(--ink-muted)] mt-2 text-sm text-pretty"
              data-weather-description
            >
              {WEATHER_PLACEHOLDER}
            </p>
            <p class="data mt-2" data-weather-feels-like hidden></p>
          </div>
        </div>

        <p class="data mt-5" hidden data-weather-updated>
          更新 <time data-weather-observed></time>
        </p>
      </div>

      <div class="mt-5 space-y-3" data-weather-alerts hidden></div>
    </div>

    <!--
      What a reader without scripting gets. The reading is fetched from the
      crawler's object at request time and cannot be baked into the page, so the
      honest thing to say is that it is not there rather than to leave an empty
      plate.
    -->
    <noscript>
      <p class="data text-pretty">
        天気は JavaScript を有効にすると表示されます。
      </p>
    </noscript>

    <!--
      The way out of a failed or empty reading. Both are answered by the same
      action: the snapshot is a file the crawler rewrites every ten minutes, so
      asking again is the whole of what a reader can do about it.

      It sits outside the live region on purpose. Inside it, the button would be
      announced as part of the reading it is meant to be a response to.
    -->
    <button
      type="button"
      class="btn btn-sm mt-4 min-h-11"
      data-weather-retry
      hidden
    >
      再読み込み
    </button>
  </div>

  <div class="weather-report">
    <div class="border-base-300 border-t px-5 py-4" data-weather-report hidden>
      <h3 class="label mb-3">詳細</h3>
      <dl class="space-y-2" data-weather-details></dl>
    </div>
  </div>

  <template data-weather-detail-template>
    <div class="flex items-baseline justify-between gap-4 text-sm">
      <dt class="text-[color:var(--ink-muted)]"></dt>
      <dd
        class="text-right font-medium"
        style="font-variant-numeric: tabular-nums"
      ></dd>
    </div>
  </template>

  <template data-weather-alert-template>
    <div class="border-warning/50 bg-warning/10 border p-3" role="status">
      <p class="text-sm font-semibold" data-alert-event></p>
      <p class="data mt-1" data-alert-time></p>
      <p
        class="text-[color:var(--ink-muted)] mt-1 text-sm text-pretty whitespace-pre-line"
        data-alert-description
      ></p>
    </div>
  </template>
</section>

<script>
  import { enhanceWeatherWidget } from "../scripts/weather-widget";

  enhanceWeatherWidget();
</script>
