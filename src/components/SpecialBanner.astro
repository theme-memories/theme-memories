---
import bgHeading from "../assets/special/bg-heading.webp";
import bgHeadingPc from "../assets/special/bg-heading-pc.webp";
import headingSpecial from "../assets/special/heading-special.svg";
---

<main
  class="page-main special"
  style={`--page-main-special-bg-sp: url(${bgHeading.src}); --page-main-special-bg-pc: url(${bgHeadingPc.src}); --page-main-special-heading: url(${headingSpecial.src});`}
>
  <div class="page-main-title">
    <h1 class="page-main-title-text">SPECIAL</h1>
  </div>
</main>
