---
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

const today = new Date();
---

<!--
  The colophon. A heavy top rule, the site line on the left and the two
  machine-facing links on the right, so the foot of the page reads as the end of
  a publication rather than as a second navigation block.
-->
<footer class="colophon">
  <div class="site-container">
    <div class="colophon-inner">
      <p class="colophon-site">
        {SITE_TITLE}
        <span class="colophon-note ms-2">{SITE_DESCRIPTION}</span>
      </p>

      <nav class="colophon-links" aria-label="購読とサイト案内">
        <a class="link-quiet" href="/rss.xml">
          RSS
        </a>
        <a class="link-quiet" href="/sitemap-index.xml">
          SITEMAP
        </a>
      </nav>
    </div>

    <p class="colophon-note pb-6">
      &copy; {today.getFullYear()}
      {SITE_TITLE}. All rights reserved.
    </p>
  </div>
</footer>
