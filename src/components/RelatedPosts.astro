---
import FormattedDate from "./FormattedDate.astro";

interface RelatedItem {
  href: string;
  title: string;
  date: Date;
}

interface Props {
  posts: RelatedItem[];
}

const { posts } = Astro.props;
---

<!--
  関連記事. A short ruled list of headlines, newest first, drawn from the same
  category as the article it closes. The number is decorative and pinned to two
  digits so the titles align down the list.

  `related-heading` is a hand-written literal, not a generated id: the section
  and its `<h2>` name each other through the one string, and because this
  component renders at most once per page that string is unique in the document.
  No library is involved — `aria-labelledby` is plain ARIA, and the id is what it
  points at.
-->
{posts.length > 0 && (
  <section class="mt-16" aria-labelledby="related-heading">
    <div class="section-head">
      <h2 id="related-heading" class="section-title">
        関連記事
      </h2>
    </div>
    <div class="related-list mt-2">
      {posts.map((post, index) => (
        <a class="related-item" href={post.href}>
          <span class="related-index" aria-hidden="true">
            {String(index + 1).padStart(2, "0")}
          </span>
          <span class="related-title">{post.title}</span>
          <span class="related-date">
            <FormattedDate date={post.date} />
          </span>
        </a>
      ))}
    </div>
  </section>
)}
