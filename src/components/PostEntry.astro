---
import type { CollectionEntry } from "astro:content";
import CategoryBadge from "./CategoryBadge.astro";
import FormattedDate from "./FormattedDate.astro";
import Icon from "./Icon.astro";

interface Props {
  post: CollectionEntry<"article"> | CollectionEntry<"vault">;
  /*
   * The row is a list item, so its heading belongs one level under whatever
   * heads the list it sits in. `/posts` has no heading above the rows and takes
   * the default; the home page's index sits under 一覧 and takes 3, so that
   * heading scopes its own entries instead of reading as their peer.
   */
  level?: 2 | 3;
}

const { post, level = 2 } = Astro.props;
const Heading = `h${level}` as "h2" | "h3";
const { title, description, pubDate, category, pinned } = post.data;
const href = `/${post.collection}/${post.data.slug}`;
---

<a
  href={href}
  class="post-row"
  data-post
  data-category={category}
  data-year={pubDate.getFullYear()}
>
  <!--
    The number is decoration: it is drawn by a CSS counter (see `.post-grid` in
    components.css) and kept out of the accessibility tree, so the title is what
    a screen reader reads rather than "zero one".
  -->
  <span class="post-row-index" aria-hidden="true"></span>
  <Heading class="post-row-title">{title}</Heading>
  <p class="post-row-meta">
    <span class="data post-row-date">
      <FormattedDate date={pubDate} />
    </span>
    <CategoryBadge category={category} />
    {pinned && (
      <span class="badge badge-primary badge-sm" aria-label="固定">
        固定
      </span>
    )}
  </p>
  <p class="post-row-excerpt">{description}</p>
  <Icon name="arrow" class="post-row-mark text-[1.125rem]" />
</a>
