---
import { categories, categoryKeys } from "../data/categories";
import { FILTER_ALL } from "../utils/post-filter";

interface Props {
  years: number[];
}

const { years } = Astro.props;
---

<!--
  daisyUI's `filter`: a radio group that collapses to the chosen option plus a
  reset, so the bar stays a single line as options are added. Nothing is checked
  to begin with, so the full set is visible and the empty selection is what
  "すべて" means; choosing an option hides the rest and shows the reset, which is
  the one way back. Each group is its own `<form>` so its reset restores only its
  own state, and the `value`/`data` attributes the script reads are on the inputs.

  The separator and the labels are daisyUI's, but the two groups and the count
  stay in the site's own frame.
-->
<div
  class="border-base-300 flex flex-wrap items-center justify-between gap-x-8 gap-y-4 border-y py-4"
  data-post-filter
>
  <div class="flex flex-wrap items-center gap-x-8 gap-y-4">
    <div class="flex flex-wrap items-center gap-3">
      <span id="post-filter-category-label" class="label">
        カテゴリー
      </span>
      <form class="filter" aria-labelledby="post-filter-category-label">
        <input
          class="btn btn-square"
          type="reset"
          value="×"
          aria-label="カテゴリーの絞り込みを解除"
        />
        <input
          class="btn"
          type="radio"
          name="post-category"
          value={FILTER_ALL}
          aria-label="すべて"
          data-filter-group="category"
        />
        {categoryKeys.map((key) => (
          <input
            class="btn"
            type="radio"
            name="post-category"
            value={key}
            aria-label={categories[key].name}
            data-filter-group="category"
          />
        ))}
      </form>
    </div>

    {years.length > 1 && (
      <div class="flex flex-wrap items-center gap-3">
        <span id="post-filter-year-label" class="label">
          年
        </span>
        <form class="filter" aria-labelledby="post-filter-year-label">
          <input
            class="btn btn-square"
            type="reset"
            value="×"
            aria-label="年の絞り込みを解除"
          />
          <input
            class="btn"
            type="radio"
            name="post-year"
            value={FILTER_ALL}
            aria-label="すべて"
            data-filter-group="year"
          />
          {years.map((year) => (
            <input
              class="btn"
              type="radio"
              name="post-year"
              value={year}
              aria-label={String(year)}
              data-filter-group="year"
            />
          ))}
        </form>
      </div>
    )}
  </div>

  <p class="data" data-post-filter-count aria-live="polite"></p>
</div>

<script>
  import { enhancePostFilter } from "../scripts/post-filter";

  enhancePostFilter();
</script>
