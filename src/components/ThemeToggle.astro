---
import Icon from "./Icon.astro";
---

<label class="theme-toggle border-base-300 hover:border-base-content/40 hover:bg-base-200 swap swap-rotate size-10 border transition-colors">
  <input
    type="checkbox"
    data-theme-toggle
    aria-label="ダークテーマに切り替える"
  />
  <Icon name="sun" class="swap-off text-[1.125rem]" />
  <Icon name="moon" class="swap-on text-[1.125rem]" />
</label>

<!--
  The checkbox has to be ticked before paint or a dark-mode reader sees the sun
  for a frame. The head script already resolved the mode and left it on the root
  element, so this only has to read it; the shared wiring in `theme.ts` takes
  over from there.
-->
<script is:inline>
  (() => {
    const toggle = document.querySelector("[data-theme-toggle]");
    if (toggle instanceof HTMLInputElement) {
      toggle.checked = document.documentElement.dataset.mode === "dark";
    }
  })();
</script>
