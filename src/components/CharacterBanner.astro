---
import bgHeading from "../assets/character/bg-heading.webp";
import bgHeadingPc from "../assets/character/bg-heading-pc.webp";
import headingCharacter from "../assets/character/heading-character.svg";
---

<main
  class="page-main character"
  style={`--page-main-character-bg-sp: url(${bgHeading.src}); --page-main-character-bg-pc: url(${bgHeadingPc.src}); --page-main-character-heading: url(${headingCharacter.src});`}
>
  <div class="page-main-title">
    <h1 class="page-main-title-text">CHARACTER</h1>
  </div>
</main>
