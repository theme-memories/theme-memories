---
import bgHeading from "../assets/news/bg-heading.webp";
import bgHeadingPc from "../assets/news/bg-heading-pc.webp";
import headingStory from "../assets/story/heading-story.svg";
---

<main
  class="page-main story"
  style={`--page-main-story-bg-sp: url(${bgHeading.src}); --page-main-story-bg-pc: url(${bgHeadingPc.src}); --page-main-story-heading: url(${headingStory.src});`}
>
  <div class="page-main-title">
    <h1 class="page-main-title-text">STORY</h1>
  </div>
</main>
