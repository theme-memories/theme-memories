---
import { NAV_ITEMS, SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
import Icon from "./Icon.astro";
import PaletteSwitch from "./PaletteSwitch.astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="border-base-300 bg-base-100/85 sticky top-0 z-40 border-b backdrop-blur">
  <div class="site-container">
    <div class="flex h-16 items-center gap-3">
      <button
        id="drawer-open"
        type="button"
        class="btn btn-ghost btn-square btn-sm min-h-11 min-w-11 lg:hidden"
        aria-controls="site-drawer"
        aria-expanded="false"
        aria-label="ナビゲーションを開く"
      >
        <Icon name="menu" class="text-[1.25rem]" />
      </button>

      <!--
        The running head: the nameplate with the tagline under it, so the header
        says both what the site is called and what it is about.
      -->
      <a href="/" class="wordmark-group">
        <span class="wordmark">{SITE_TITLE}</span>
        <span class="wordmark-tagline">{SITE_DESCRIPTION}</span>
      </a>

      <nav class="ms-auto hidden lg:block" aria-label="メインナビゲーション">
        <ul class="nav-list">
          {NAV_ITEMS.map((item) => (
            <li>
              <HeaderLink href={item.href} match={item.match}>
                {item.label}
              </HeaderLink>
            </li>
          ))}
        </ul>
      </nav>

      <div class="ms-auto flex items-center gap-2 lg:ms-8">
        <!--
          The palette switch needs room the narrowest header cannot spare, so it
          moves into the drawer below `sm` rather than crowding the wordmark.
        -->
        <div class="hidden sm:block">
          <PaletteSwitch name="palette" />
        </div>
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>
