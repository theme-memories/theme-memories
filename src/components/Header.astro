---
import { NAV_ITEMS, SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
import Icon from "./Icon.astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="border-base-300 bg-base-100/85 sticky top-0 z-40 border-b backdrop-blur">
  <div class="site-container">
    <div class="flex h-16 items-center gap-3">
      <button
        id="drawer-open"
        type="button"
        class="btn btn-ghost btn-square btn-sm min-h-11 min-w-11 lg:hidden"
        aria-controls="site-drawer"
        aria-expanded="false"
        aria-label="ナビゲーションを開く"
      >
        <Icon name="menu" class="text-[1.25rem]" />
      </button>

      <a href="/" class="wordmark">
        {SITE_TITLE}
      </a>

      <nav class="ms-auto hidden lg:block" aria-label="メインナビゲーション">
        <ul class="nav-list">
          {NAV_ITEMS.map((item) => (
            <li>
              <HeaderLink href={item.href} match={item.match}>
                {item.label}
              </HeaderLink>
            </li>
          ))}
        </ul>
      </nav>

      <div class="ms-auto lg:ms-8">
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>
