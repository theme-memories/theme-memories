---
import { Image } from "astro:assets";
import TagList from "@components/TagList.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import ImgA from "../assets/mizuki-gallery/003.webp";
import ImgB from "../assets/mizuki-gallery/026.webp";
import ImgC from "../assets/mizuki-gallery/055.webp";
import ImgD from "../assets/mizuki-gallery/056.webp";

/*
 * The page covers three things, in order: the article body (本文), the site's
 * own editorial furniture (エディトリアル), and then the daisyUI components
 * these themes style, grouped the way the daisyUI documentation groups them.
 *
 * Every daisyUI component the live site already renders is deliberately absent
 * from the gallery — a running page already shows it, so a specimen here would
 * only duplicate it. The register of those is the note below.
 *
 * The index and the sections below are both driven from this list, so a section
 * cannot be linked to without being shown.
 */
const groups = [
  {
    name: "概要",
    items: [{ id: "implemented", label: "実装済みコンポーネント" }],
  },
  {
    name: "本文",
    items: [
      { id: "prose-heading", label: "見出し" },
      { id: "prose-body", label: "段落とリスト" },
      { id: "prose-inline", label: "強調と意味づけ" },
      { id: "prose-quote", label: "引用" },
      { id: "prose-table", label: "表" },
      { id: "prose-rule", label: "区切り" },
      { id: "prose-indent", label: "字下げ" },
    ],
  },
  {
    name: "エディトリアル",
    items: [
      { id: "editorial-heading", label: "見出し" },
      { id: "editorial-tags", label: "タグ" },
    ],
  },
  {
    name: "Actions",
    items: [
      { id: "dropdown", label: "Dropdown" },
      { id: "fab", label: "FAB / Speed Dial" },
      { id: "modal", label: "Modal" },
      { id: "theme-controller", label: "Theme Controller" },
    ],
  },
  {
    name: "Data display",
    items: [
      { id: "accordion", label: "Accordion" },
      { id: "avatar", label: "Avatar" },
      { id: "aura", label: "Aura" },
      { id: "badge", label: "Badge" },
      { id: "carousel", label: "Carousel" },
      { id: "chat", label: "Chat bubble" },
      { id: "collapse", label: "Collapse" },
      { id: "countdown", label: "Countdown" },
      { id: "diff", label: "Diff" },
      { id: "hover-3d", label: "Hover 3D Card" },
      { id: "hover-gallery", label: "Hover Gallery" },
      { id: "kbd", label: "Kbd" },
      { id: "status", label: "Status" },
      { id: "text-rotate", label: "Text Rotate" },
      { id: "timeline", label: "Timeline" },
    ],
  },
  {
    name: "Navigation",
    items: [
      { id: "dock", label: "Dock" },
      { id: "link", label: "Link" },
      { id: "megamenu", label: "Megamenu" },
      { id: "menu", label: "Menu" },
      { id: "navbar", label: "Navbar" },
      { id: "pagination", label: "Pagination" },
      { id: "steps", label: "Steps" },
    ],
  },
  {
    name: "Feedback",
    items: [
      { id: "loading", label: "Loading" },
      { id: "progress", label: "Progress" },
      { id: "radial-progress", label: "Radial Progress" },
      { id: "tooltip", label: "Tooltip" },
    ],
  },
  {
    name: "Data input",
    items: [
      { id: "calendar", label: "Calendar" },
      { id: "checkbox", label: "Checkbox" },
      { id: "fieldset", label: "Fieldset" },
      { id: "file-input", label: "File Input" },
      { id: "filter", label: "Filter" },
      { id: "label", label: "Label" },
      { id: "radio", label: "Radio" },
      { id: "range", label: "Range" },
      { id: "rating", label: "Rating" },
      { id: "select", label: "Select" },
      { id: "textarea", label: "Textarea" },
      { id: "toggle", label: "Toggle" },
      { id: "validator", label: "Validator" },
      { id: "otp", label: "OTP" },
    ],
  },
  {
    name: "Layout",
    items: [
      { id: "hero", label: "Hero" },
      { id: "indicator", label: "Indicator" },
      { id: "join", label: "Join" },
      { id: "mask", label: "Mask" },
      { id: "stack", label: "Stack" },
    ],
  },
  {
    name: "Mockup",
    items: [
      { id: "mockup-browser", label: "Browser" },
      { id: "mockup-phone", label: "Phone" },
    ],
  },
];
---

<BaseLayout
  title="スタイルガイド"
  description="このサイトの本文組版・エディトリアルの部品・daisyUI コンポーネントを、実際のテーマで確認できるリファレンス。"
>
  <header class="site-container pt-14 pb-8 sm:pt-20">
    <h1 class="page-title">スタイルガイド</h1>
    <p class="page-lead mt-5">
      このサイトの見た目を実際のテーマで確認するためのリファレンス。記事本文の組版（本文）、記事の外側で使う部品（エディトリアル）、daisyUI
      のコンポーネントの三つをまとめています。ヘッダーのスイッチで藍（ai /
      kon）と朱（kinari / sumi）を切り替えられます。
    </p>
  </header>

  <div class="site-container pb-20">
    <!-- The index, built from the same list the sections below are. -->
    <nav class="mt-10" aria-label="コンポーネント一覧">
      <h2 class="label mb-3">On this page</h2>
      <div class="grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-3">
        {groups.map((group) => (
          <div>
            <p class="label mb-2">{group.name}</p>
            <ul class="space-y-1 text-sm">
              {group.items.map((item) => (
                <li>
                  <a class="link-quiet" href={`#${item.id}`}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </nav>

    <!--
      The register of daisyUI components the live site already renders. Each is
      shown by a running page, so it is not demonstrated again here; this is the
      map from the component to where it appears. Keep it in step with the real
      usage when a component is added or moved.
    -->
    <section class="mt-16">
      <h2
        id="implemented"
        class="section-title border-base-300 border-b pb-3 scroll-mt-24"
      >
        実装済みコンポーネント
      </h2>
      <p class="page-lead mt-4 max-w-2xl">
        次の daisyUI
        コンポーネントは、すでにサイトの実ページで動いています。同じものをここにも並べると重複するだけなので、見本は置かず、使われている場所だけを示します。
      </p>
      <ul class="mt-6 grid gap-x-8 gap-y-2 text-sm sm:grid-cols-2">
        <li>
          <span class="font-medium">Drawer</span>
          <span class="data">
            — モバイルのナビゲーションドロワー（BaseLayout）
          </span>
        </li>
        <li>
          <span class="font-medium">Divider</span>
          <span class="data">— 記事ヒーローの区切り（BlogPost）</span>
        </li>
        <li>
          <span class="font-medium">Button</span>
          <span class="data">
            — ホーム・記事一覧・ログイン・天気ウィジェット・ヘッダー
          </span>
        </li>
        <li>
          <span class="font-medium">Swap</span>
          <span class="data">— 明暗テーマの切り替え（ThemeToggle）</span>
        </li>
        <li>
          <span class="font-medium">Card / Card body</span>
          <span class="data">— アーカイブ・天気・プロフィール・ログイン</span>
        </li>
        <li>
          <span class="font-medium">Stat</span>
          <span class="data">— アーカイブの記事数・天気の数値</span>
        </li>
        <li>
          <span class="font-medium">List / List row</span>
          <span class="data">— アーカイブのカテゴリー・天気の詳細</span>
        </li>
        <li>
          <span class="font-medium">Table</span>
          <span class="data">— プロフィールのスペック表</span>
        </li>
        <li>
          <span class="font-medium">Tabs</span>
          <span class="data">— プロフィールの年代切り替え</span>
        </li>
        <li>
          <span class="font-medium">Alert</span>
          <span class="data">— トーストと 500 ページ</span>
        </li>
        <li>
          <span class="font-medium">Toast</span>
          <span class="data">— サイトのエラー通知（Toast）</span>
        </li>
        <li>
          <span class="font-medium">Skeleton</span>
          <span class="data">— 天気の読み込みプレースホルダー</span>
        </li>
        <li>
          <span class="font-medium">Input / Validator</span>
          <span class="data">— ログインのパスワード欄</span>
        </li>
        <li>
          <span class="font-medium">Filter</span>
          <span class="data">— 記事一覧のカテゴリー・年の絞り込み</span>
        </li>
        <li>
          <span class="font-medium">Breadcrumbs</span>
          <span class="data">— 記事ページのパンくずリスト</span>
        </li>
      </ul>
      <p class="page-lead mt-6 max-w-2xl">
        注記: 記事ページの「ページトップへ」（<code>.back-to-top</code>
        ）は、uBlock Origin などの広告ブロッカーが持つ Annoyances
        フィルターが同名の要素を隠すため、有効にしていると表示されません。
      </p>
    </section>

    <!-- 本文（prose） -->
    <h2
      id="prose"
      class="section-title border-base-300 mt-16 border-b pb-3 scroll-mt-24"
    >
      本文（prose）
    </h2>
    <p class="page-lead mt-4 max-w-2xl">
      記事本文（<code>.prose</code>）の組版。Tailwind Typography の出力を
      daisyUI のトークンに結び直したもので、Markdown
      から生成される見出し・段落・リスト・強調・引用・表などの見え方をまとめます。
    </p>

    <section class="mt-8">
      <h3 id="prose-heading" class="font-bold scroll-mt-24">
        見出し
      </h3>
      <div class="prose mt-4 max-w-2xl">
        <h2>見出しレベル2</h2>
        <p>
          h2
          は上に長い罫線を伴います。日本語は字面が大きいので、見出しは欧文より広めの余白を取ります。
        </p>
        <h3>見出しレベル3</h3>
        <p>h3 は h2 の一段下の見出しです。</p>
        <h4>見出しレベル4</h4>
        <p>h4 まで下がると余白は詰まり、本文に近づきます。</p>
      </div>
    </section>

    <section class="mt-8">
      <h3 id="prose-body" class="font-bold scroll-mt-24">
        段落とリスト
      </h3>
      <div class="prose mt-4 max-w-2xl">
        <p>
          段落は行間を広めに取り、続く段落とのあいだに余白を置きます。日本語は行長が揃いやすいので、読みやすさは行間と余白でつくります。
        </p>
        <p>段落のなかの改行は段落を分けません。空行が新しい段落を始めます。</p>
        <ul>
          <li>順序のないリスト</li>
          <li>二つ目の項目</li>
        </ul>
        <ol>
          <li>順序のあるリスト</li>
          <li>二つ目の項目</li>
        </ol>
      </div>
    </section>

    <section class="mt-8">
      <h3 id="prose-inline" class="font-bold scroll-mt-24">
        強調と意味づけ
      </h3>
      <div class="prose mt-4 max-w-2xl">
        <p>
          強調は圏点（<em>強調</em>）で示します。日本語には斜体がないため、
          <strong>太字</strong>と圏点で書き分けます。ルビは{" "}
          <ruby>
            漢字<rt>かんじ</rt>
          </ruby>{" "}
          のように親文字の上に載ります。
        </p>
        <p>
          インラインコードは <code>pnpm build</code>{" "}
          のように本文と同じ面板に載ります。<a href="#prose-inline">リンク</a>
          は下線を伴い、<del>削除</del> は差分の色で示します。
        </p>
      </div>
    </section>

    <section class="mt-8">
      <h3 id="prose-quote" class="font-bold scroll-mt-24">
        引用
      </h3>
      <div class="prose mt-4 max-w-2xl">
        <blockquote>
          <p>引用は左の罫線で示し、出典は一段落として添えます。</p>
          <footer>
            — ロブ・パイク、<cite>Concurrency Is Not Parallelism</cite>
          </footer>
        </blockquote>
      </div>
    </section>

    <section class="mt-8">
      <h3 id="prose-table" class="font-bold scroll-mt-24">
        表
      </h3>
      <div class="prose mt-4 max-w-2xl">
        <table>
          <thead>
            <tr>
              <th>項目</th>
              <th>値</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>見出し</td>
              <td>罫線付き</td>
            </tr>
            <tr>
              <td>本文</td>
              <td>行間 1.9</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-8">
      <h3 id="prose-rule" class="font-bold scroll-mt-24">
        区切り
      </h3>
      <div class="prose mt-4 max-w-2xl">
        <p>区切り線は本文の左右いっぱいに引きます。</p>
        <hr />
        <p>セクションの切れ目を示します。</p>
      </div>
    </section>

    <section class="mt-8">
      <h3 id="prose-indent" class="font-bold scroll-mt-24">
        字下げ
      </h3>
      <p class="page-lead mt-4 max-w-2xl">
        字下げ（<code>.prose-indent</code>
        ）を有効にすると、段落の一行目が一字下がります。
      </p>
      <div class="prose prose-indent mt-4 max-w-2xl">
        <p>字下げを有効にすると、段落の一行目が一字下がります。</p>
        <p>段落の間隔は詰まり、字下げが段落の切れ目を示します。</p>
      </div>
    </section>

    <!-- エディトリアル -->
    <h2
      id="editorial"
      class="section-title border-base-300 mt-16 border-b pb-3 scroll-mt-24"
    >
      エディトリアル
    </h2>
    <p class="page-lead mt-4 max-w-2xl">
      記事の外側で使う部品。見出しに添えるラベルと、記事の分類を示すタグです。
    </p>

    <section class="mt-8">
      <h3 id="editorial-heading" class="font-bold scroll-mt-24">
        見出し
      </h3>
      <div class="mt-4 flex flex-col gap-8">
        <div>
          <span class="eyebrow">肩書き</span>
          <p class="data mt-2">.eyebrow — 見出しに付く小さなラベル</p>
        </div>
        <div>
          <div class="section-head">
            <h4 class="section-title">セクション見出し</h4>
            <a class="link-quiet text-sm" href="#editorial-heading">
              補助リンク →
            </a>
          </div>
          <p class="data mt-2">.section-head — 見出しと罫線</p>
        </div>
      </div>
    </section>

    <section class="mt-8">
      <h3 id="editorial-tags" class="font-bold scroll-mt-24">
        タグ
      </h3>
      <div class="mt-4">
        <TagList
          tags={[
            { label: "技術", href: "#editorial-tags", category: "tech" },
            { label: "生活", href: "#editorial-tags", category: "life" },
            { label: "雑記", href: "#editorial-tags", category: "notes" },
          ]}
        />
      </div>
    </section>

    <!-- Actions -->
    <h2
      id="actions"
      class="section-title border-base-300 mt-16 border-b pb-3 scroll-mt-24"
    >
      Actions
    </h2>

    <section class="mt-8">
      <h3 id="dropdown" class="font-bold scroll-mt-24">
        Dropdown
      </h3>
      <div class="mt-4 flex flex-wrap gap-4">
        <details class="dropdown">
          <summary class="btn">Open dropdown</summary>
          <ul class="dropdown-content menu bg-base-100 border-base-300 rounded-box z-10 w-52 border p-2">
            <li>
              <a href="#dropdown">Item one</a>
            </li>
            <li>
              <a href="#dropdown">Item two</a>
            </li>
            <li>
              <a href="#dropdown">Item three</a>
            </li>
          </ul>
        </details>
      </div>
    </section>

    <section class="mt-8">
      <h3 id="fab" class="font-bold scroll-mt-24">
        FAB / Speed Dial
      </h3>
      <div class="mt-4 flex items-end gap-8">
        <!--
          A FAB is pinned to a screen corner. Shown `static` here so it sits in
          the flow rather than floating over the page.
        -->
        <div class="fab static">
          <button
            class="btn btn-lg btn-circle btn-primary"
            aria-label="Actions"
          >
            +
          </button>
        </div>
        <p class="data">Shown in flow; normally fixed to a corner.</p>
      </div>
    </section>

    <section class="mt-8">
      <h3 id="modal" class="font-bold scroll-mt-24">
        Modal
      </h3>
      <div class="mt-4">
        <button class="btn" popovertarget="sg-modal">
          Open modal
        </button>
        <div class="modal" popover id="sg-modal">
          <div class="modal-box">
            <h4 class="text-lg font-bold">Modal title</h4>
            <p class="py-4">
              This modal is opened with the popover API, so it needs no script.
            </p>
            <div class="modal-action">
              <button
                class="btn"
                popovertarget="sg-modal"
                popovertargetaction="hide"
              >
                Close
              </button>
            </div>
          </div>
          <div class="modal-backdrop">
            <button popovertarget="sg-modal" popovertargetaction="hide">
              close
            </button>
          </div>
        </div>
      </div>
    </section>

    <section class="mt-8">
      <h3 id="theme-controller" class="font-bold scroll-mt-24">
        Theme Controller
      </h3>
      <div class="mt-4">
        <label class="label cursor-pointer justify-start gap-3">
          <input type="checkbox" value="ai" class="toggle theme-controller" />
          <span>Switch to the 藍 (ai) theme</span>
        </label>
        <p class="data mt-2">
          The site's own palette switch mirrors this mechanism so it can pair a
          palette with the light/dark mode.
        </p>
      </div>
    </section>

    <!-- Data display -->
    <h2
      id="data-display"
      class="section-title border-base-300 mt-16 border-b pb-3 scroll-mt-24"
    >
      Data display
    </h2>

    <section class="mt-8">
      <h3 id="accordion" class="font-bold scroll-mt-24">
        Accordion
      </h3>
      <div class="join join-vertical mt-4 w-full max-w-lg">
        <div class="border-base-300 collapse join-item collapse-arrow border">
          <input type="radio" name="sg-accordion" checked />
          <div class="collapse-title font-semibold">Item one</div>
          <div class="collapse-content text-sm">
            Radio inputs sharing one name make a real accordion: opening one
            closes the other.
          </div>
        </div>
        <div class="border-base-300 collapse join-item collapse-arrow border">
          <input type="radio" name="sg-accordion" />
          <div class="collapse-title font-semibold">Item two</div>
          <div class="collapse-content text-sm">The second panel.</div>
        </div>
      </div>
    </section>

    <section class="mt-8">
      <h3 id="avatar" class="font-bold scroll-mt-24">
        Avatar
      </h3>
      <div class="mt-4 flex items-center gap-4">
        <div class="avatar">
          <div class="w-16 rounded-full">
            <Image
              src={ImgA}
              width={64}
              height={64}
              alt=""
              class="h-full w-full object-cover"
            />
          </div>
        </div>
        <div class="avatar avatar-online">
          <div class="w-16 rounded-full">
            <Image
              src={ImgB}
              width={64}
              height={64}
              alt=""
              class="h-full w-full object-cover"
            />
          </div>
        </div>
        <div class="avatar-group -space-x-6">
          <div class="avatar">
            <div class="w-12 rounded-full">
              <Image
                src={ImgA}
                width={48}
                height={48}
                alt=""
                class="h-full w-full object-cover"
              />
            </div>
          </div>
          <div class="avatar">
            <div class="w-12 rounded-full">
              <Image
                src={ImgC}
                width={48}
                height={48}
                alt=""
                class="h-full w-full object-cover"
              />
            </div>
          </div>
          <div class="avatar avatar-placeholder">
            <div class="bg-neutral text-neutral-content w-12 rounded-full">
              <span>+3</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="mt-8">
      <h3 id="aura" class="font-bold scroll-mt-24">
        Aura
      </h3>
      <div class="mt-4">
        <div class="aura aura-glow rounded-box w-fit">
          <button class="btn btn-primary">Glowing button</button>
        </div>
      </div>
    </section>

    <section class="mt-8">
      <h3 id="badge" class="font-bold scroll-mt-24">
        Badge
      </h3>
      <div class="mt-4 flex flex-wrap items-center gap-2">
        <span class="badge">Badge</span>
        <span class="badge badge-primary">Primary</span>
        <span class="badge badge-outline">Outline</span>
        <span class="badge badge-soft badge-accent">Soft</span>
        <span class="badge badge-success">Success</span>
        <span class="badge badge-error badge-sm">sm</span>
      </div>
    </section>

    <section class="mt-8">
      <h3 id="carousel" class="font-bold scroll-mt-24">
        Carousel
      </h3>
      <div class="carousel mt-4 w-full max-w-sm rounded-box">
        {[ImgA, ImgB, ImgC].map((src) => (
          <div class="carousel-item w-full">
            <Image
              src={src}
              width={512}
              height={320}
              alt=""
