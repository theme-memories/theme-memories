---
import { Image } from "astro:assets";
import ArchiveWidget from "../components/ArchiveWidget.astro";
import CategoryBadge from "../components/CategoryBadge.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Icon from "../components/Icon.astro";
import PostEntry from "../components/PostEntry.astro";
import WeatherWidget from "../components/WeatherWidget.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { byPinnedThenDate, getArticles, getVaultEntries } from "../utils/posts";
import { toSrcset } from "../utils/srcset";
/*
 * The masthead art is two pictures, not one: a portrait frame for phones and a
 * landscape frame for wide screens, the way the site this borrows from art
 * directs its main visual. Astro's <Picture> only swaps *formats* per <source>,
 * so the media query has to be written out by hand.
 */
import HeroPhone from "../assets/index/hero.webp";
import HeroPc from "../assets/index/hero-pc.webp";

const articles = (await getArticles()).sort(byPinnedThenDate);
const [lead, ...rest] = articles;
const index = rest.slice(0, 5);

/*
 * The rail's figures and categories describe the whole archive rather than the
 * articles this page happens to list, so the vault entries are gathered too:
 * they are posts as well, and they reach further back than any article.
 */
const vaultEntries = await getVaultEntries();
const archive = [...articles, ...vaultEntries];

/*
 * The `md` breakpoint. The portrait frame is drawn for a phone, so past this
 * width it stops being a phone picture and starts being an 1100px wall that
 * pushes the description off the screen.
 */
const PC_BREAKPOINT = "48rem";
const PC_WIDTHS = [1024, 1440, 1920, 2560];

const heroPcSrcset = await toSrcset(HeroPc, PC_WIDTHS);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <!--
    The running head names the site on every page, and the home page still has to
    open its own outline with that name. It is set off screen so the name is not
    said a second time as a visible plate under the art.
  -->
  <h1 class="sr-only">{SITE_TITLE}</h1>

  <!--
    The masthead art.

    The art carries the block on its own: the running head already sets the site
    name and its tagline on every page, so repeating the pair below the art would
    say the same thing twice. The description was briefly set on top of the art
    behind a dark scrim, and the scrim is gone because the two are the same
    decision: every band of both frames contains near-black pixels (line-art
    outlines, dark clothing, the buildings), so measured against either the
    lightest or the darkest text colour there is no band wide enough to hold a
    headline. The choice was a scrim or the page surface, and the art is the
    reason this block exists.

    The last of the image still dissolves into the page rather than ending on a
    hard seam. That is a mask, not a colour, so it lands on whatever the page
    surface is in either theme.
  -->
  <section class="bg-base-100">
    <picture>
      <source
        media={`(min-width: ${PC_BREAKPOINT})`}
        srcset={heroPcSrcset}
        sizes="100vw"
        type="image/webp"
      />
      <Image
        src={HeroPhone}
        alt=""
        widths={[480, 750, 1125, 1500]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="mask-b-from-92% block max-h-[70svh] w-full object-cover lg:h-[min(59.375vw,70svh)] lg:max-h-none"
      />
    </picture>
  </section>

  {lead && (
    <section class="bg-base-200">
      <div class="site-container py-14 sm:py-16">
        <article
          class:list={[
            "grid gap-8 lg:gap-14",
            lead.data.heroImage && "lg:grid-cols-2 lg:items-center",
          ]}
        >
          <div>
            <div class="flex flex-wrap items-center gap-3">
              <span class="eyebrow">最新</span>
              {lead.data.pinned && (
                <span class="badge badge-primary badge-sm" aria-label="固定">
                  固定
                </span>
              )}
            </div>
            <h2 class="display-title mt-5">
              <a
                href={`/${lead.collection}/${lead.data.slug}`}
                class="hover:text-[color:var(--ink-accent)] transition-colors"
              >
                {lead.data.title}
              </a>
            </h2>
            <p class="page-lead mt-5">{lead.data.description}</p>

            <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2">
              <CategoryBadge category={lead.data.category} />
              <span class="data">
                <FormattedDate date={lead.data.pubDate} />
              </span>
            </div>

            <a
              href={`/${lead.collection}/${lead.data.slug}`}
              class="btn btn-primary mt-8 min-h-11"
            >
              記事を読む
              <Icon name="arrow" class="text-[1.125rem]" />
            </a>
          </div>

          {lead.data.heroImage && (
            <figure class="media-frame">
              <Image
                width={720}
                height={480}
                src={lead.data.heroImage}
                alt=""
                loading="eager"
                class="h-full w-full object-cover"
              />
            </figure>
          )}
        </article>
      </div>
    </section>
  )}

  <section class="site-container pt-16 pb-20">
    <div class="grid gap-14 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-16">
      <div>
        <div class="section-head">
          <h2 class="section-title">一覧</h2>
          <a href="/posts" class="link-quiet text-sm">
            すべての記事 →
          </a>
        </div>
        <div class="post-grid">
          {index.map((post) => (
            <PostEntry post={post} level={3} />
          ))}
        </div>
      </div>

      <div class="flex flex-col gap-12">
        <WeatherWidget />

        <ArchiveWidget posts={archive} />
      </div>
    </div>
  </section>
</BaseLayout>
