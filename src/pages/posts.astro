---
import PostEntry from "@components/PostEntry.astro";
import PostFilter from "@components/PostFilter.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { getPostYears, toFilterablePost } from "@utils/post-filter";
import { byPinnedThenDate, getArticles, getVaultEntries } from "@utils/posts";

const posts = (await Promise.all([getArticles(), getVaultEntries()]))
  .flat()
  .sort(byPinnedThenDate);
const years = getPostYears(posts.map(toFilterablePost));
---

<BaseLayout title={`記事 · ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
  <header class="site-container pt-14 pb-8 sm:pt-20">
    <h1 class="page-title">記事</h1>
    <p class="data mt-4">全 {posts.length} 件</p>
  </header>

  <section class="site-container pb-20">
    <PostFilter years={years} />

    <div class="border-base-300 mt-10 border-t" data-post-grid>
      {posts.map((post) => (
        <PostEntry post={post} />
      ))}
    </div>

    <div class="post-empty" data-post-empty hidden>
      <p class="post-empty-title">条件に一致する記事がありません。</p>
      <p class="page-lead mt-3">
        カテゴリーと年を「すべて」に戻すと、全 {posts.length} 件が表示されます。
      </p>
      <button type="button" class="btn mt-6 min-h-11" data-post-filter-reset>
        絞り込みを解除
      </button>
    </div>
  </section>
</BaseLayout>
