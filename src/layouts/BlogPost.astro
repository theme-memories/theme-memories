---
import type { MarkdownHeading } from "astro";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BackToTop from "../components/BackToTop.astro";
import FormattedDate from "../components/FormattedDate.astro";
import PostNav from "../components/PostNav.astro";
import ShareLinks from "../components/ShareLinks.astro";
import TableOfContents from "../components/TableOfContents.astro";
import TagList from "../components/TagList.astro";
import BaseLayout from "./BaseLayout.astro";
import { categories } from "../data/categories";

type NavItem = { href: string; title: string };

type Props = CollectionEntry<"article">["data"] & {
  headings: MarkdownHeading[];
  minutesRead?: string;
  noindex?: boolean;
  prev?: NavItem;
  next?: NavItem;
};
type Crumb = { href?: string; label: string };

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  category,
  headings,
  minutesRead,
  noindex = false,
  prev,
  next,
} = Astro.props;

const crumbs: Crumb[] = Astro.url.pathname.startsWith("/article")
  ? [
      { href: "/", label: "ホーム" },
      { href: "/posts", label: "記事" },
      { label: title },
    ]
  : [{ href: "/", label: "ホーム" }, { label: title }];

/*
 * The share row is offered only for a public post. A gated post is `noindex` and
 * its URL redirects a reader to the unlock page, so inviting a share would hand
 * the reader a link that asks for a password rather than the article.
 */
const canShare = !noindex;
---

<BaseLayout
  title={title}
  description={description}
  image={heroImage}
  noindex={noindex}
>
  <article class="site-container py-10 sm:py-14">
    <div class="article-grid">
      <nav
        class="article-crumbs breadcrumbs text-sm"
        aria-label="パンくずリスト"
      >
        <ul>
          {crumbs.map((crumb) => (
            <li>
              {crumb.href ? (
                <a href={crumb.href} class="link-quiet">
                  {crumb.label}
                </a>
              ) : (
                <span
                  class="max-w-[18rem] truncate text-[color:var(--ink-muted)]"
                  aria-current="page"
                >
                  {crumb.label}
                </span>
              )}
            </li>
          ))}
        </ul>
      </nav>

      <dl class="article-meta">
        <div>
          <dt>公開</dt>
          <dd>
            <FormattedDate date={pubDate} />
          </dd>
        </div>
        {updatedDate && (
          <div>
            <dt>更新</dt>
            <dd>
              <FormattedDate date={updatedDate} />
            </dd>
          </div>
        )}
        {minutesRead && (
          <div>
            <dt>読了</dt>
            <dd>{minutesRead}</dd>
          </div>
        )}
      </dl>

      <div class="article-body">
        <header>
          <span class="eyebrow">{categories[category].name}</span>
          <h1 class="display-title mt-4">{title}</h1>
          <p class="page-lead mt-5">{description}</p>
        </header>

        {heroImage && (
          <>
            {/* The lead and the banner are different kinds of thing: a sentence
                of prose and a picture. daisyUI's divider separates them without
                inventing a heading or a box for either. */}
            <div class="divider"></div>

            <figure class="media-frame">
              <Image
                width={1020}
                height={680}
                src={heroImage}
                alt=""
                loading="eager"
                class="aspect-[3/2] h-auto w-full object-cover"
              />
            </figure>
          </>
        )}

        <div class="prose mt-10">
          <slot />
        </div>

        <!--
          The reading furniture. It closes the article rather than framing it:
          the tags say what it is filed under and the share row hands it on. It
          stays inside the body's measure, so the column the reader has been
          reading down is the column the furniture is ruled to.

          The share row and the two steps both move along the public archive, so
          a gated post carries neither: its URL redirects to the unlock page, and
          a share or a public neighbour would hand the reader a link that asks
          for a password. The tag stays, because the category is what the post is
          filed under wherever it is read.
        -->
        <footer class="mt-16 flex flex-col gap-10">
          <div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-6">
            <TagList
              tags={[
                {
                  label: categories[category].name,
                  href: `/posts?category=${category}`,
                  category,
                },
              ]}
            />
            {canShare && <ShareLinks url={Astro.url.href} title={title} />}
          </div>

          {canShare && <PostNav prev={prev} next={next} />}
        </footer>
      </div>

      <TableOfContents headings={headings} />
    </div>
  </article>

  <BackToTop />
</BaseLayout>

<script>
  import PhotoSwipeDynamicCaption from "photoswipe-dynamic-caption-plugin";
  import PhotoSwipeLightbox from "photoswipe/lightbox";

  // Astro resolves markdown images to their optimised URLs while rendering,
  // which is after the markdown plugins have run, so the lightbox is wired up
  // here in the browser. PhotoSwipe reads the large image and its dimensions
  // from the link around each thumbnail, so wrap every content image in one and
  // carry the rendered size across as data attributes.
  const gallery = document.querySelector<HTMLElement>(".prose");
  const images = gallery?.querySelectorAll<HTMLImageElement>("img") ?? [];

  for (const image of images) {
    if (image.closest("a")) continue;

    // A gallery image belongs to its carousel, and the carousel owns the click
    // that drags it, so it is left out of the post's lightbox.
    if (image.closest(".swiper-gallery")) continue;

    const width = Number(image.getAttribute("width")) || image.naturalWidth;
    const height = Number(image.getAttribute("height")) || image.naturalHeight;
    if (!width || !height) continue;

    const link = document.createElement("a");
    link.className = "pswp-item";
    link.href = image.currentSrc || image.src;
    link.dataset.pswpWidth = String(width);
    link.dataset.pswpHeight = String(height);

    image.replaceWith(link);
    link.appendChild(image);
  }

  if (gallery?.querySelector("a.pswp-item")) {
    const lightbox = new PhotoSwipeLightbox({
      gallery,
      children: "a.pswp-item",
      pswpModule: () => import("photoswipe"),
      /*
       * PhotoSwipe labels its own chrome in English and has no locale files, so
       * the words the gallery speaks are set here.
       */
      closeTitle: "閉じる",
      zoomTitle: "拡大",
      arrowPrevTitle: "前の画像",
      arrowNextTitle: "次の画像",
    });

    // Captions fall back to each image's `alt` text and are placed beside or
    // below the photo depending on the space the viewport has for them.
    new PhotoSwipeDynamicCaption(lightbox, { type: "auto" });

    // PhotoSwipe has to be initialised after its plugins are attached.
    lightbox.init();
  }
</script>

<script>
  // Expressive Code makes wide code blocks horizontally scrollable. Without a
  // tab stop they cannot be scrolled by keyboard, so mark the overflowing ones
  // focusable and keep that in sync as the viewport changes.
  const codeBlocks = document.querySelectorAll<HTMLElement>(
    ".expressive-code pre",
  );
  const syncFocusable = (block: HTMLElement) => {
    block.tabIndex = block.scrollWidth > block.clientWidth ? 0 : -1;
  };
  const observer = new ResizeObserver((entries) => {
    for (const entry of entries) syncFocusable(entry.target as HTMLElement);
  });
  for (const block of codeBlocks) {
    syncFocusable(block);
    observer.observe(block);
  }
</script>

<script>
  import { enhanceMediaPlayers } from "../scripts/media-player";

  // Markdown authors a declarative Video.js player around plain <audio>/<video>
  // elements, so the elements are registered in the browser, only on pages that
  // actually contain a player.
  enhanceMediaPlayers(".prose video-player, .prose audio-player");
</script>

<script>
  // Galleries are authored in Markdown as plain images inside a container, so
  // the carousel is built up here rather than by an Astro component the Markdown
  // pipeline cannot import.
  import { enhanceSwiperGalleries } from "../scripts/swiper-gallery";

  enhanceSwiperGalleries();
</script>
