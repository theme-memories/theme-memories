{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "theme-memories-tests",
  "main": "src/tests/test-worker.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "vars": {
    "VAULT_SIGNING_SECRET": "unit-test-signing-secret-0123456789abcdef",
  },
  "r2_buckets": [
    {
      "binding": "VAULT_BUCKET",
      "bucket_name": "theme-memories-test",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "theme-memories-test",
      "database_id": "00000000-0000-0000-0000-000000000001",
    },
  ],
  "ratelimits": [
    {
      "name": "VAULT_RL",
      "namespace_id": "1001",
      "simple": {
        "limit": 600,
        "period": 60,
      },
    },
    {
      "name": "VAULT_AUTH_RL",
      "namespace_id": "1002",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
  ],
}
